# ── Produção (docker-compose.prod.yml) ─────────────────────────────
# Gerar segredos: openssl rand -hex 48
DB_NAME=eplenarius
DB_USER=eplenarius
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Origens permitidas no CORS (separadas por vírgula)
FRONTEND_URL=https://eplenarius.seudominio.com.br

# Porta no host (Nginx faz proxy para 127.0.0.1:API_HOST_PORT)
API_HOST_PORT=3010
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
# true só no primeiro boot com banco vazio (cria tabelas); depois volte para false
DB_SYNCHRONIZE=false

# ── Dev local (npm run start:dev) ──────────────────────────────────
# NODE_ENV=development
# DEV_DATABASE_URL=postgres://eplenarius:eplenarius_secret@127.0.0.1:5434/eplenarius
